#!/usr/bin/env bash
# ==================================================
# .husky/pre-commit
# Runs quality gates before every commit:
#   1. Secret scanning
#   2. Lint (if available)
#   3. Build check (if available)
# ==================================================

echo "[pre-commit] Running quality gates..."

# --- Gate 1: Secret scanning ---
bash scripts/check-secrets.sh || exit 1

# --- Gate 2: Lint (skip if npm not initialised yet) ---
if [ -f "package.json" ]; then
  npm run lint --if-present || exit 1
fi

# --- Gate 3: Build (skip if npm not initialised yet) ---
if [ -f "package.json" ]; then
  npm run build --if-present || exit 1
fi

echo "[pre-commit] All gates passed."