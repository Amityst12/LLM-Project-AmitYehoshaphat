# ============================================
# .gitignore — LLM-Project-AmitYehoshaphat
# ============================================

# ----- Secrets & Environment -----
.env
.env.*
!.env.example

# ----- Node.js -----
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ----- Byte-compiled / cache -----
__pycache__/
*.py[cod]
*$py.class
*.js.map

# ----- OS files -----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ----- IDE / Editor -----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Package manager -----
# Keep package-lock.json committed
!package-lock.json
